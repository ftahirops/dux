[Unit]
Description=dux realtime disk-usage + file-search index
Documentation=https://github.com/ftahirops/dux/blob/main/README.md
After=local-fs.target
# Keep recovery attempts enabled without rapid restart loops on older systemd.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45s
WatchdogSignal=SIGABRT
# The index contains sensitive path names; watchdog aborts must not persist a
# process core image containing the in-memory index or queued event paths.
LimitCORE=0
# The daemon attaches watches first, then builds/reconciles in the background.
# Queries keep the prior compatible snapshot while the baseline is replaced.
# On a high-churn host the growth-history table dominates index size; shrink the
# retention window if needed, e.g.: ExecStart=/usr/bin/dux daemon / --growth-days 2
ExecStart=/usr/bin/dux daemon /
Restart=always
# Keep a conservative restart delay across supported systemd releases. Rocky 9's
# systemd 252 rejects RestartSteps/RestartMaxDelaySec, so use portable syntax.
RestartSec=30s
# Liveness heartbeat lives in /run/dux (tmpfs), not SQLite, so an idle daemon
# makes zero DB/WAL writes. RuntimeDirectory creates it and removes it on stop,
# so the heartbeat file vanishes when the daemon dies (no stale "live").
RuntimeDirectory=dux
RuntimeDirectoryMode=0755

# Run with a dedicated service UID; fanotify and handle reads use only the
# explicitly granted ambient capabilities below. The `dux` group grants
# controlled query access; 0027 makes the index 0640 dux:dux, not world-readable.
# See "index exposure" at the bottom of this file.
User=dux
Group=dux
UMask=0027
StateDirectory=dux
StateDirectoryMode=0750
# First-time scan can take a while on big/slow disks; give it room.
TimeoutStartSec=3600
# The daemon has a bounded event-drain path, but an in-flight SQLite batch can
# outlive systemd's 90s default on a busy index. Allow its atomic commit/rollback
# and durable dirty marker to finish before systemd escalates to SIGKILL.
TimeoutStopSec=300s

# Stay out of the way of real workloads. `daemon --max-cpu` (default 25%) limits
# only the fanotify event-loop thread; SQLite, scan and maintenance workers also
# consume process CPU. The idle I/O priority is a best-effort scheduling hint.
# CPUQuota and memory limits below are the process-wide hard ceilings. If CPUQuota
# is saturated, event lag and fanotify overflow can still require reconciliation.
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
# cgroup-v2 weights: give dux the least CPU/IO share under contention.
CPUWeight=10
IOWeight=10
# Export per-service block I/O counters so operators can distinguish Dux I/O
# from host-wide device activity during pressure incidents.
IOAccounting=yes
# Kernel-enforced process-wide ceiling. The event-loop governor does not cover
# scanner, SQLite, or maintenance-worker CPU, so this bounds their combined use.
CPUQuota=100%
# Full scans use a bounded queue + disk-backed staging DB. These remain generous
# backstops for SQLite, an extreme pending-event storm, and moved-in subtrees.
MemoryHigh=2G
MemoryMax=4G
OOMPolicy=stop
# Avoid biasing the long-lived daemon as a preferred global-OOM victim.
OOMScoreAdjust=0

# fanotify needs CAP_SYS_ADMIN; reading all files needs DAC override. Keep both
# capabilities in the daemon's ambient set for the non-root service UID. Alert
# hooks clear ambient, effective, permitted, and inheritable capabilities.
# NOTE: do NOT enable ProtectSystem/ProtectHome/PrivateTmp/PrivateMounts/
# ReadOnlyPaths etc. — those put the service in a PRIVATE MOUNT NAMESPACE, and a
# fanotify filesystem mark there would not see writes through the host's mounts.
#
# Remote-access privileges belong only to the separate optional tunnel service.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
SecureBits=noroot noroot-locked
# Hardening that does NOT require a private mount namespace (all fanotify-safe):
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# ProtectKernelModules=yes also masks /usr/lib/modules in a private mount
# namespace, making the disk index silently omit the host's kernel modules.
# CAP_SYS_MODULE is already absent from CapabilityBoundingSet; keep the module
# syscalls blocked without changing the filesystem view used by the scanner.
# The daemon needs open_by_handle_at for fanotify FID resolution, but does not
# mount filesystems or chroot. @mount contains only mount/chroot syscalls on
# systemd 252 and 255; it does not include open_by_handle_at. Also deny syscall
# groups with no Dux use: swap control, reboot/kexec, clock changes, obsolete
# compatibility calls, raw port I/O, ptrace/perf debugging, and CPU emulation.
# Deny the BPF syscall too: Dux does not use it, and CAP_SYS_ADMIN may authorize
# legacy BPF operations on kernels that predate CAP_BPF checks.
# Keep @resources (nice/ioprio) and @privileged (fanotify and
# open_by_handle_at) available as required.
# clock_gettime and clock_nanosleep are implicitly allowed by systemd's filter;
# ProtectClock and @clock deny wall-clock changes.
SystemCallFilter=~@module @mount @swap @reboot @clock @obsolete @raw-io @debug @cpu-emulation bpf
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The packaged daemon opens no network sockets. Keep its address-family access
# local by default. If a systemd override enables a networked --alert-exec hook,
# explicitly expand this to AF_UNIX AF_INET AF_INET6 for that service.
RestrictAddressFamilies=AF_UNIX

# --- index exposure (READ THIS) -------------------------------------------
# The index at /var/lib/dux/dux.db contains the FULL FILENAME LIST of the root
# filesystem, including names inside directories a user could not otherwise
# traverse. Reading the index therefore bypasses directory permissions: it does
# not expose file CONTENTS, but it does expose the existence and names of every
# path on the box.
#
# The index is therefore 0640 dux:dux (see User=/Group=/UMask=/StateDirectory*
# above), NOT world-readable. Grant a trusted user direct query access with:
#     usermod -aG dux alice     # alice can now run `dux find` / `dux status`
# Everyone else is denied and must go through a privileged wrapper.
#
# To restrict queries to the service account and root, keep `User=dux` and set:
#     StateDirectoryMode=0700
#     UMask=0077
# (the daemon then creates dux.db 0600.)
#
# To restore the old world-readable behaviour (NOT recommended — any local user
# can then enumerate every filename on /), drop `Group=dux` and set:
#     StateDirectoryMode=0755
#     UMask=0022

[Install]
WantedBy=multi-user.target
