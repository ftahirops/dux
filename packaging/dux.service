[Unit]
Description=dux realtime disk-usage + file-search index
Documentation=man:dux(1)
After=local-fs.target
# Never rate-limit recovery attempts. RestartSteps below prevents a tight loop
# when the failure is persistent (bad capability/kernel/configuration).
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45s
WatchdogSignal=SIGABRT
# Build the index ONLY if one doesn't exist yet (first install / fresh boot).
# On restarts ExecStartPre skips the scan so the service becomes ready immediately.
# The daemon then reconciles the downtime gap in the background into an atomic
# replacement while queries continue using the previous index.
ExecStartPre=/bin/sh -c '[ -s /var/lib/dux/dux.db ] || /usr/bin/dux scan / --quiet --low-priority'
# On a high-churn host the growth-history table dominates index size; shrink the
# retention window if needed, e.g.: ExecStart=/usr/bin/dux daemon / --growth-days 2
ExecStart=/usr/bin/dux daemon /
Restart=always
RestartSec=2s
RestartSteps=6
RestartMaxDelaySec=1min
# Liveness heartbeat lives in /run/dux (tmpfs), not SQLite, so an idle daemon
# makes zero DB/WAL writes. RuntimeDirectory creates it and removes it on stop,
# so the heartbeat file vanishes when the daemon dies (no stale "live").
RuntimeDirectory=dux
RuntimeDirectoryMode=0755

# Index ownership: runs as root (fanotify needs CAP_SYS_ADMIN) but with the `dux`
# group, and a 0027 umask, so the index lands 0640 root:dux instead of 0644.
# See "index exposure" at the bottom of this file.
Group=dux
UMask=0027
StateDirectory=dux
StateDirectoryMode=0750
# First-time scan can take a while on big/slow disks; give it room.
TimeoutStartSec=3600

# Stay out of the way of real workloads. dux self-governs its CPU in-process
# (`daemon --max-cpu`, default 25% of one core) and runs at idle I/O priority so
# it never contends for disk; the cgroup limits below are a kernel-enforced
# backstop in case the in-process governor is ever bypassed.
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
# cgroup-v2 weights: give dux the least CPU/IO share under contention.
CPUWeight=10
IOWeight=10
# Hard ceiling (kernel-enforced). Sits ABOVE the in-process --max-cpu target so
# the governor is the primary limiter and this only catches a runaway.
CPUQuota=50%
# Full scans use a bounded queue + disk-backed staging DB. These remain generous
# backstops for SQLite, an extreme pending-event storm, and moved-in subtrees.
MemoryHigh=2G
MemoryMax=4G
OOMPolicy=stop

# fanotify needs CAP_SYS_ADMIN; reading all files needs DAC override.
# NOTE: do NOT enable ProtectSystem/ProtectHome/PrivateTmp/PrivateMounts/
# ReadOnlyPaths etc. — those put the service in a PRIVATE MOUNT NAMESPACE, and a
# fanotify filesystem mark there would not see writes through the host's mounts.
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
# Cap what the process can ever acquire to exactly the two it needs (CAP_SYS_ADMIN
# is broad, so this is the main lever for reducing the privilege surface).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
# Hardening that does NOT require a private mount namespace (all fanotify-safe):
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The alert exec (--alert-exec) and nothing else needs the network; if you don't
# use it you can also set: RestrictAddressFamilies=AF_UNIX

# --- index exposure (READ THIS) -------------------------------------------
# The index at /var/lib/dux/dux.db contains the FULL FILENAME LIST of the root
# filesystem, including names inside directories a user could not otherwise
# traverse. Reading the index therefore bypasses directory permissions: it does
# not expose file CONTENTS, but it does expose the existence and names of every
# path on the box.
#
# The index is therefore 0640 root:dux (see Group=/UMask=/StateDirectory* above),
# NOT world-readable. Grant a trusted user direct query access with:
#     usermod -aG dux alice     # alice can now run `dux find` / `dux status`
# Everyone else is denied and must go through a privileged wrapper.
#
# To go further and make the index ROOT-ONLY, drop `Group=dux` and set:
#     StateDirectoryMode=0700
#     UMask=0077
# (the daemon then creates dux.db 0600.)
#
# To restore the old world-readable behaviour (NOT recommended — any local user
# can then enumerate every filename on /), drop `Group=dux` and set:
#     StateDirectoryMode=0755
#     UMask=0022

[Install]
WantedBy=multi-user.target
