#!/bin/sh
set -e

# The `dux` group gates read access to the index. The index lists every filename
# on /, so it is 0640 root:dux rather than world-readable; members of this group
# (and root) can run `dux find` / `dux status` directly. Must exist BEFORE the
# unit starts — systemd resolves Group= at activation.
if ! getent group dux >/dev/null 2>&1; then
    addgroup --system dux >/dev/null
fi

# StateDirectory= enforces this on systemd starts too; this also covers the
# non-systemd path. The helper rejects symlinked paths before chgrp/chmod so a
# damaged state directory cannot redirect root's permission changes elsewhere.
mkdir -p /var/lib/dux
/usr/lib/dux/secure-index-permissions.sh /var/lib/dux dux

case "$1" in
    configure)
        # Remote access is operator-configured through the separate disabled
        # dux-tunnel.service. Installation never creates identities or starts it.

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            if [ -z "${2:-}" ]; then
                systemctl enable dux.service
            fi
            # --no-block leaves package operations responsive. The service attaches
            # watches before its background baseline scan and reports progress via
            # `dux status` while keeping the initial generation queryable.
            echo "dux: starting service — the initial scan of / runs in the BACKGROUND."
            if [ -z "${2:-}" ]; then
                systemctl start --no-block dux.service
            else
                systemctl try-restart --no-block dux.service
                systemctl try-restart --no-block dux-tunnel.service
            fi
            echo "dux: watch scan progress with:  dux status   (or: journalctl -u dux -f)"
        else
            echo "dux: systemd not detected; run 'dux scan /' then 'dux daemon /' manually."
        fi
        echo "dux: the index is readable by root and the 'dux' group (it lists every"
        echo "dux: filename on /). Grant a user access with: usermod -aG dux <user>"
        ;;
esac

exit 0
