#!/bin/sh
set -e

# The dedicated `dux` service account uses the two capabilities needed for
# fanotify and path-handle reads without running with UID 0. The `dux` group
# gates index queries. Both identities must exist before the unit starts.
if ! getent group dux >/dev/null 2>&1; then
    addgroup --system dux >/dev/null
fi
if ! getent passwd dux >/dev/null 2>&1; then
    adduser --system --ingroup dux --no-create-home --home /nonexistent \
        --shell /usr/sbin/nologin dux >/dev/null
else
    account=$(getent passwd dux)
    account_uid=$(printf '%s\n' "$account" | cut -d: -f3)
    account_gid=$(printf '%s\n' "$account" | cut -d: -f4)
    account_home=$(printf '%s\n' "$account" | cut -d: -f6)
    account_shell=$(printf '%s\n' "$account" | cut -d: -f7)
    dux_gid=$(getent group dux | cut -d: -f3)
    case "${account_shell##*/}" in nologin|false) ;; *) account_uid=0 ;; esac
    if [ "$account_uid" = 0 ] || [ "$account_gid" != "$dux_gid" ] \
       || [ "$account_home" != /nonexistent ]; then
        echo "dux: existing 'dux' account is not the expected locked service account" >&2
        exit 1
    fi
fi

# On upgrade, stop the old daemon synchronously before transferring its open
# database to the service UID. Preserve inactive state; only restart a daemon
# that was active before this migration.
was_active=no
upgrade_marker=/run/dux-deb-upgrade-was-active
if [ -d /run/systemd/system ]; then
    if [ -f "$upgrade_marker" ] && [ ! -L "$upgrade_marker" ]; then
        was_active=yes
        rm -f "$upgrade_marker"
    elif systemctl is-active --quiet dux.service; then
        was_active=yes
    fi
    systemctl stop dux.service
fi

# StateDirectory= enforces ownership on systemd starts too; this also covers
# the non-systemd path. The helper rejects symlinks before changing permissions.
mkdir -p /var/lib/dux
/usr/lib/dux/secure-index-permissions.sh /var/lib/dux dux dux

case "$1" in
    configure)
        # Remote access is operator-configured through the separate disabled
        # dux-tunnel.service. Installation never creates identities or starts it.

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            if [ -z "${2:-}" ]; then
                systemctl enable dux.service
            fi
            # --no-block leaves package operations responsive. The service attaches
            # watches before its background baseline scan and reports progress via
            # `dux status` while keeping the initial generation queryable.
            echo "dux: starting service — the initial scan of / runs in the BACKGROUND."
            if [ -z "${2:-}" ]; then
                systemctl start --no-block dux.service
            else
                if [ "$was_active" = yes ]; then
                    systemctl start --no-block dux.service
                fi
                systemctl try-restart --no-block dux-tunnel.service
            fi
            echo "dux: watch scan progress with:  dux status   (or: journalctl -u dux -f)"
        else
            echo "dux: systemd not detected; run 'dux scan /' then 'dux daemon /' manually."
        fi
        echo "dux: the index is readable by the 'dux' service account and group (it lists every"
        echo "dux: filename on /). Grant a user access with: usermod -aG dux <user>"
        ;;
esac

exit 0
