#!/bin/sh
set -e
# 0.7 replaces the old per-file indexing daemon with dux-sentinel.
# Stop and disable the old daemon before its unit file is removed.
case "$1" in
    install|upgrade)
        if [ -d /run/systemd/system ]; then
            for unit in dux.service dux-tunnel.service; do
                if systemctl list-unit-files "$unit" >/dev/null 2>&1; then
                    systemctl disable --now "$unit" >/dev/null 2>&1 || true
                fi
            done
        fi
        ;;
esac
exit 0
